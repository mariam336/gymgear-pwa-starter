---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryTile from '../components/CategoryTile.astro';
import { allArticles } from '../lib/content';
import categories from '../data/categories.json';
import settings from '../data/settings.json';
const all=await allArticles();const featured=all.filter(i=>i.kind==='best').slice(0,6);const reviews=all.filter(i=>i.kind==='reviews').slice(0,3);const latest=all.filter(i=>i.kind==='buyingGuides'||i.kind==='fitnessAdvice').slice(0,3);
const schema={'@context':'https://schema.org','@graph':[{'@type':'Organization','name':settings.siteName,'url':Astro.site?.toString()},{'@type':'WebSite','name':settings.siteName,'url':Astro.site?.toString(),'description':settings.description}]};
---
<BaseLayout title="FitGear Review Hub | Independent Fitness Gear Research" description={settings.description} schema={schema}>
<section class="main-hero"><div class="shell hero-layout"><div class="hero-left"><div class="hero-eyebrow"><span class="status-dot"></span> SMARTER GEAR. STRONGER YOU.</div><h1>
<h1>
  Find the right gym equipment.
  <br />
  Train smarter. <em>Spend less.</em>
</h1>
</h1><p class="hero-lead">Detailed fitness equipment reviews, practical buying guides, and honest comparisons to help you train smarter and spend wisely.</p><div class="hero-buttons"><a class="btn btn-lime" href="/best/">Explore best gear <Icon name="arrowUp" size={17}/></a><a class="btn btn-ghost" href="/buying-guides/">Browse buying guides <Icon name="arrow" size={18}/></a></div><div class="hero-footer"><span><Icon name="check" size={18}/> Research-based recommendations</span><span><Icon name="check" size={18}/> No fake ratings</span></div></div><div class="hero-right"><img src="/images/hero-fitness.svg" width="800" height="720" alt="Stylized adjustable dumbbell and weight plates on a dark green background" fetchpriority="high"/><div class="hero-float"><span class="float-label">FOCUS ON WHAT MATTERS</span><strong>Better decisions.<br/>Better training.</strong></div></div></div></section>
<section class="trust-strip"><div class="shell trust-grid"><div><Icon name="shield" size={23}/><span><strong>Transparent research</strong><small>Evidence over marketing</small></span></div><div><Icon name="scales" size={24}/><span><strong>Clear comparisons</strong><small>Understand the trade-offs</small></span></div><div><Icon name="book" size={23}/><span><strong>Beginner-friendly guides</strong><small>Useful advice, no jargon</small></span></div></div></section>
<section class="section-block shell" id="categories"><div class="section-head"><div><span class="eyebrow eyebrow-dark"><span class="eyebrow-line"></span>EXPLORE BY CATEGORY</span><h2>Find gear that fits <span class="serif-italic">your training.</span></h2><p>Browse straightforward guidance across the equipment that matters most.</p></div><a href="/search/" class="section-link">Explore all topics <Icon name="arrowUp" size={17}/></a></div><div class="category-grid">{categories.map((c,i)=><CategoryTile category={c} index={i}/>)}</div></section>
<section class="section-soft"><div class="shell section-block"><div class="section-head"><div><span class="eyebrow eyebrow-dark"><span class="eyebrow-line"></span>CURATED BUYING GUIDES</span><h2>Popular gear, <span class="serif-italic">explained.</span></h2><p>What to look for before investing in your next piece of equipment.</p></div><a href="/best/" class="section-link">View all roundups <Icon name="arrowUp" size={17}/></a></div><div class="article-grid-cards">{featured.map(item=><ArticleCard item={item}/>)}</div></div></section>
<section class="editorial-band"><div class="shell editorial-band-inner"><div><span class="eyebrow">THE FITGEAR APPROACH</span><h2>No hype. No shortcuts.<br/><em>Just better buying advice.</em></h2></div><div><p>We explain the features, limitations and buying considerations that actually matter. Demo records are never presented as hands-on reviews.</p><a class="btn btn-lime" href="/how-we-test/">How we evaluate <Icon name="arrowUp" size={17}/></a></div></div></section>
<section class="section-block shell"><div class="section-head"><div><span class="eyebrow eyebrow-dark"><span class="eyebrow-line"></span>INDIVIDUAL REVIEWS</span><h2>Closer looks at <span class="serif-italic">key equipment.</span></h2><p>Our review page structure keeps advantages, limitations, and research sources visible.</p></div><a href="/reviews/" class="section-link">All product reviews <Icon name="arrowUp" size={17}/></a></div><div class="article-grid-cards">{reviews.map(item=><ArticleCard item={item}/>)}</div></section>
<section class="compare-promo"><div class="shell compare-promo-content"><div class="compare-graphic" aria-hidden="true"><span>01</span><span>VS</span><span>02</span></div><div><span class="eyebrow">MAKE THE SMARTER CHOICE</span><h2>Compare equipment<br/>side by side.</h2><p>Look at differences in use case, storage, and important specifications—without guesswork.</p></div><a href="/compare/" class="btn btn-lime">Open compare tool <Icon name="arrowUp" size={17}/></a></div></section>
<section class="section-block shell"><div class="section-head"><div><span class="eyebrow eyebrow-dark"><span class="eyebrow-line"></span>KEEP LEARNING</span><h2>Advice that goes <span class="serif-italic">beyond the product.</span></h2><p>Build a smarter home gym, understand key features, and avoid costly mistakes.</p></div><a href="/fitness-advice/" class="section-link">More advice <Icon name="arrowUp" size={17}/></a></div><div class="article-grid-cards">{latest.map(item=><ArticleCard item={item}/>)}</div></section>
<section class="newsletter-section"><div class="shell newsletter-panel"><div class="newsletter-icon"><Icon name="mail" size={32}/></div><div><span class="eyebrow eyebrow-dark">GOOD GEAR. GOOD ADVICE.</span><h2>Training smarter starts here.</h2><p>Newsletter signup is not active yet. Once you connect an email provider, subscribers can receive fresh buying guides and comparisons.</p></div><div class="newsletter-coming"><span>NEWSLETTER COMING SOON</span><a href="/contact/">Contact us instead <Icon name="arrowUp" size={16}/></a></div></div></section>
</BaseLayout>
