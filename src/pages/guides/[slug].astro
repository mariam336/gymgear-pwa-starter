---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides, type BuyingGuide } from '../../data/guides';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const {guide}=Astro.props as {guide:BuyingGuide};
---
<BaseLayout title={`${guide.title} | GymGear Guide`} description={guide.subtitle}>
  <section class="article-hero"><div class="container article-inner"><a class="breadcrumb" href="/">← All guides</a><p class="kicker">{guide.category.toUpperCase()} · RESEARCH GUIDE</p><h1>{guide.title}</h1><p class="article-lead">{guide.subtitle}</p><div class="notice">Editorial note: This sample guide explains selection criteria. It does not claim personal testing or recommend specific products.</div></div></section>
  <article class="container article-content">
    <h2>Overview</h2><p>{guide.intro}</p>
    <h2>Who this guide is for</h2><p>{guide.forWho}</p>
    <h2>What to compare before buying</h2><ul>{guide.criteria.map(x=><li>{x}</li>)}</ul>
    <h2>Common mistakes to avoid</h2><ul>{guide.pitfalls.map(x=><li>{x}</li>)}</ul>
    <h2>About product links</h2><p>No affiliate links are included in this starter. Add verified retailers only after applying to an affiliate program; clearly disclose any commission relationship and mark paid links with <code>rel="sponsored"</code>.</p>
    <div class="article-next"><strong>Still exploring?</strong><a class="btn btn-dark" href="/#guides">Browse more guides →</a></div>
  </article>
</BaseLayout>
